<launch>
	<arg name="drone_id" default="1" />

   	<node pkg="ground_visual_analysis" type="semantic_map_manager" name="semantic_map_manager" output="screen" ><!-- launch-prefix="xterm -fn 10x20 -e" -->
		<env name="SMM_GEOMETRIC_MAP_FILE" value="$(find ground_visual_analysis)/maps/DEMO_1.binvox.bt" />
		<env name="SMM_OUTPUT_FOLDER"      value="$(find ground_visual_analysis)/KML" />
                <env name="XML_PATH"               value="$(find ground_visual_analysis)/KML/Static_Map_Annotations_Final.kml"/>
	</node>

	<rosparam command="load" file="$(find ground_visual_analysis)/config/BMMC_camera.yaml" />
        <rosparam command="load" file="$(find ground_visual_analysis)/config/common_param.yaml" />
	<param name="drone_id" value="$arg drone_id"/>

</launch>
